# Base de développement
POSTGRES_USER=immo
POSTGRES_PASSWORD=immo_local
POSTGRES_DB=immoservice
POSTGRES_PORT=5433

# Base de test (séparée)
POSTGRES_TEST_DB=immoservice_test
POSTGRES_TEST_PORT=5434

DATABASE_URL=postgresql://immo:immo_local@localhost:5433/immoservice
DATABASE_URL_TEST=postgresql://immo:immo_local@localhost:5434/immoservice_test

# Authentification (à remplacer par une longue chaîne aléatoire dans .env)
JWT_SECRET=a_generer
JWT_EXPIRES_IN=1h

# Serveur
PORT=3000
