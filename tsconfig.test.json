{
  // Vérification des types des tests ET du SDK généré : si la spec change, ce contrôle échoue.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "sdk", "vitest.config.ts"]
}
